# Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=evolve
DB_USER=evolve_app
DB_PASSWORD=REPLACE_WITH_STRONG_MYSQL_PASSWORD
DB_POOL_MIN=2
DB_POOL_MAX=10

# Backend Server Configuration
API_HOST=127.0.0.1
API_PORT=3001
NODE_ENV=production

# Authentication & Security
# Generate a strong 32+ character random secret: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_GENERATED_JWT_SECRET_32_CHARS_MIN
# Set COOKIE_SECURE=true when serving over HTTPS; set to false if testing over plain HTTP
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Allowed CORS origins in development & testing (comma-separated).
# For HTTP testing on the VPS: CORS_ALLOWED_ORIGINS=http://129.121.127.182:8080 with COOKIE_SECURE=false
# For HTTPS production: CORS_ALLOWED_ORIGINS=https://evolve.yourdomain.com with COOKIE_SECURE=true
CORS_ALLOWED_ORIGINS=http://129.121.127.182:8080